  @@index([departmentId])
  @@index([mentorId])
  @@map("department_mentors")
}

model InternProject {
  id         String   @id @default(uuid())
  internId   String
  projectId  String
  role       String   @default("MEMBER")
  assignedAt DateTime @default(now())
  intern     Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([internId, projectId])
  @@index([internId])
  @@index([projectId])
  @@map("intern_projects")
}

model EmailLog {
  id             String        @id @default(uuid())
  to             String
  subject        String
  organizationId String?
  status         String        @default("PENDING") // PENDING, SENT, FAILED
  error          String?
  attempts       Int           @default(0)
  templateName   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([to])
  @@index([organizationId])
  @@map("email_logs")
}

model InternDocument {
  id             String        @id @default(uuid())
  internId       String
  organizationId String?
  type           String   // 'CERTIFICATE', 'OFFER_LETTER', 'PERFORMANCE_REPORT'
  name           String   // e.g., "Certificate of Completion", "Monthly Report - May 2026"
  url            String   // Cloudinary URL
  publicId       String   // Cloudinary public ID
  metadata       Json?    // Optional metadata (e.g., month/year for reports)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  intern         Intern        @relation(fields: [internId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([internId])
  @@index([type])
  @@index([organizationId])
  @@map("intern_documents")
}

model ParsedResume {
  id              String   @id @default(uuid())
  userId          String
  name            String
  email           String
  phone           String
  skills          String[] @default([])
  education       Json?
  experience      Json?
  projects        Json?
  skillScore      Float
  experienceYears Float
  deletedByUser   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("parsed_resumes")
}

model Placement {
  id              String        @id @default(uuid())
  internId        String        @map("intern_id")
  internName      String        @map("intern_name")
  mentorId        String        @map("mentor_id")
  mentorName      String        @map("mentor_name")
  organizationId  String?       @map("organization_id")
  department      String
  matchScore      Float         @map("match_score")
  confidenceLevel String        @map("confidence_level")
  appliedBy       String        @map("applied_by")
  appliedAt       DateTime      @default(now()) @map("applied_at")
  status          String        @default("Pending") // Pending | Confirmed | Revoked
  undoDeadline    DateTime      @map("undo_deadline")
  emailSent       Boolean       @default(false) @map("email_sent")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("placements")
}

model MentorAvailability {
  mentorId           String   @id @map("mentor_id")
  currentInternCount Int      @default(0) @map("current_intern_count")
  maxCapacity        Int      @default(3) @map("max_capacity")
  status             String   @default("Available") @map("status") // Available | Busy | At Capacity
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("mentor_availability")
}

model ActionItem {
  id         String   @id @default(uuid())
  feedbackId String?
  internId   String
  mentorId   String?
  task       String
  status     String   @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  intern     Intern    @relation(fields: [internId], references: [id], onDelete: Cascade)
  mentor     Mentor?   @relation(fields: [mentorId], references: [id])

  @@index([feedbackId])
  @@index([internId])
  @@index([mentorId])
