// ── Goals ──────────────────────────────────────────────────────

enum GoalStatus {
  IN_PROGRESS
  ACHIEVED
  PARTIALLY_ACHIEVED
  NOT_ACHIEVED
}

model Goal {
  id               String        @id @default(uuid())
  internId         String
  organizationId   String?
  title            String        @db.VarChar(500)
  description      String?       @db.Text
  weekStartDate    DateTime      @db.Date
  weekEndDate      DateTime      @db.Date
  status           GoalStatus    @default(IN_PROGRESS)
  aiEvaluation     String?       @db.Text
  completionRate   Float?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  intern           Intern        @relation(fields: [internId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id])
  tasks            Task[]

  @@index([internId])
  @@index([organizationId])
  @@index([weekStartDate])
  @@index([status])
  @@map("goals")
}

// ── Mock Interviews ──────────────────────────────────────────────

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ReadinessLevel {
  READY
  NEARLY_READY
  NEEDS_PRACTICE
}

enum QuestionType {
  TECHNICAL
  BEHAVIORAL
  SITUATIONAL
}

model MockInterview {
  id              String                  @id @default(uuid())
  internId        String
  organizationId  String?
  jobRole         String
  status          InterviewStatus         @default(IN_PROGRESS)
  overallScore    Float?
  readinessLevel  ReadinessLevel?
  aiSummary       String?                 @db.Text
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  intern          Intern                  @relation(fields: [internId], references: [id], onDelete: Cascade)
  organization    Organization?           @relation(fields: [organizationId], references: [id])
  questions       MockInterviewQuestion[]

  @@index([internId])
  @@index([organizationId])
  @@index([status])
  @@map("mock_interviews")
}

model MockInterviewQuestion {
  id             String        @id @default(uuid())
  interviewId    String
  questionNumber Int
  questionText   String        @db.Text
  questionType   QuestionType
  internAnswer   String?       @db.Text
  aiFeedback     String?       @db.Text
  score          Int?          // 0 to 20
  answeredAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  interview      MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@map("mock_interview_questions")
}

enum VideoCallStatus {
  ACTIVE
  ENDED
  MISSED
}

model VideoCall {
  id              String          @id @default(uuid())
  organizationId  String?
  roomName        String          @unique
  initiatedById   String
  conversationId  String?
  participants    String[]        @default([])
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  status          VideoCallStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())

  // Relations
  initiatedBy     User            @relation("InitiatedCalls", fields: [initiatedById], references: [id])
  organization    Organization?   @relation(fields: [organizationId], references: [id])
  conversation    Conversation?   @relation(fields: [conversationId], references: [id])

  @@map("video_calls")
}

