  cutoffTime           String        @default("11:30") // HH:MM
  timezone             String        @default("UTC")
  missedAlertThreshold Int           @default(3)
  weekendsEnabled      Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
