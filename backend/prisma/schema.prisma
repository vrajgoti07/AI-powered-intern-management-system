generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")    // Pooled connection for runtime queries
  directUrl = env("DIRECT_URL")      // Direct connection for Prisma migrations
}

// ── Multi-Tenant Organization ──────────────────────────────────

enum OrganizationPlan {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  logoUrl      String?
  primaryColor String           @default("#6366F1")
  domain       String?          @unique
  plan         OrganizationPlan @default(FREE)
  maxInterns   Int              @default(10)
  maxMentors   Int              @default(3)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  // Relations to all tenant-scoped models
  users                  User[]
  departments            Department[]
  interns                Intern[]
  mentors                Mentor[]
  tasks                  Task[]
  feedbacks              Feedback[]
  announcements          Announcement[]
  attendances            Attendance[]
  leaves                 Leave[]
  leaveRequests          LeaveRequest[]
  holidays               Holiday[]
  attendanceSettings     AttendanceSettings[]
  conversations          Conversation[]
  messages               Message[]
  notifications          Notification[]
  jobPostings            JobPosting[]
  candidates             Candidate[]
  interviews             Interview[]
  chatRooms              ChatRoom[]
  projects               Project[]
  auditLogs              AuditLog[]
  aiRecommendations      AIRecommendation[]
  emailLogs              EmailLog[]
  internDocuments        InternDocument[]
  placements             Placement[]
  pushSubscriptions      PushSubscription[]
  internPoints           InternPoints[]
  xpTransactions         XPTransaction[]
  internBadges           InternBadge[]
  dailyStandups          DailyStandup[]
  standupSettings        StandupSettings?
  goals                  Goal[]
  mockInterviews         MockInterview[]
  videoCalls             VideoCall[]
  submissionVectors      SubmissionVector[]
  skillGapAnalyses      SkillGapAnalysis[]
  internshipBatches     InternshipBatch[]
  savedReports          SavedReport[]
  mentorEffectivenessHistories MentorEffectivenessHistory[]
  dataExportRequests    DataExportRequest[]
  erasureRequests       ErasureRequest[]

  @@index([slug])
  @@index([isActive])
  @@map("organizations")
}

// ── User & Auth ────────────────────────────────────────────────

model User {
  id                       String                  @id @default(uuid())
  email                    String                  @unique
  password                 String
  name                     String
  role                     UserRole
  avatarUrl                String?
  username                 String?                 @unique
  isActive                 Boolean                 @default(true)
  isEmailVerified          Boolean                 @default(false)
  resetPasswordToken       String?                 @unique
  resetPasswordTokenExpiry DateTime?
  refreshToken             String?
  totpSecret               String?
  totpEnabled              Boolean                 @default(false)
  totpVerifiedAt           DateTime?
  totpBackupCodes          String[]                @default([])
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  lastLogin                DateTime?
  departmentId             String?
  mentorDepartmentId       String?
  organizationId           String?
  headedDepartment         Department?             @relation("DepartmentHead")
  intern                   Intern?
  leaveRequests            LeaveRequest[]          @relation("UserLeaveRequests")
  loginActivities          LoginActivity[]
  mentor                   Mentor?
  sentMessages             Message[]               @relation("MessageSender")
  notificationPreference   NotificationPreference?
  notifications            Notification[]
  otpVerifications         OtpVerification[]
  publicProfileSettings    PublicProfileSettings?
  trustedSessions          TrustedSession[]
  userSessions             UserSession[]
  pushSubscriptions        PushSubscription[]
  department               Department?             @relation("DepartmentInterns", fields: [departmentId], references: [id])
  mentorDepartment         Department?             @relation("DepartmentMentors", fields: [mentorDepartmentId], references: [id])
  organization             Organization?           @relation(fields: [organizationId], references: [id])
  conversations            Conversation[]          @relation("ConversationParticipants")
  readMessages             Message[]               @relation("MessageReadBy")
  chatRooms                ChatRoom[]              @relation("ChatRoomMembers")
  parsedResumes            ParsedResume[]
  initiatedCalls           VideoCall[]             @relation("InitiatedCalls")
  deletedAt                DateTime?

  @@index([email])
  @@index([role])
  @@index([username])
  @@index([organizationId])
  @@map("users")
}

model PublicProfileSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  isPublic             Boolean  @default(true)
  showSkills           Boolean  @default(true)
  showTasks            Boolean  @default(true)
  showFeedbackScore    Boolean  @default(true)
  showPerformanceGrade Boolean  @default(true)
  showAttendance       Boolean  @default(false)
  showMentorName       Boolean  @default(true)
  showCollege          Boolean  @default(true)
  customBio            String?  @db.VarChar(300)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("public_profile_settings")
}

model Department {
  id             String               @id @default(uuid())
  name           String               @unique
  code           String               @unique
  description    String?
  colorTheme     String?              @map("color")
  isActive       Boolean              @default(true)
  headId         String?              @unique
  organizationId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  activities     DepartmentActivity[]
  head           User?                @relation("DepartmentHead", fields: [headId], references: [id])
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  profileInterns Intern[]             @relation("ProfileInterns")
  jobPostings    JobPosting[]
  profileMentors Mentor[]             @relation("ProfileMentors")
  projects       Project[]
  interns        User[]               @relation("DepartmentInterns")
  mentors        User[]               @relation("DepartmentMentors")
  departmentMentors DepartmentMentor[]
  deletedAt      DateTime?

  @@index([organizationId])
  @@map("departments")
}

model Intern {
  id                  String              @id @default(uuid())
  userId              String              @unique
  phone               String?
  dob                 DateTime?
  college             String
  degree              String?
  branch              String?
  cgpa                Float?
  departmentId        String
  mentorId            String?
  organizationId      String?
  status              InternStatus        @default(PENDING)
  score               Float               @default(0)
  attendance          Float               @default(0)
  skills              String[]            @default([])
  experience          Json?
  education           Json?
  duration            String?
  startDate           DateTime?
  joinedDate          DateTime            @default(now())
  completedDate       DateTime?
  whyJoin             String?
  resumeUrl           String?
  address             String?
  workAddress         String?
  githubUrl           String?
  linkedinUrl         String?
  emergencyName       String?
  emergencyRelation   String?
  emergencyPhone      String?
  signedName          String?
  agreementAccepted   Boolean             @default(false)
  offerLetterAccepted Boolean             @default(false)
  onboardingStep      Int                 @default(0)
  gender              String?
  semester            Int?
  parentName          String?
  parentPhone         String?
  idProofUrl          String?
  marksheetUrl        String?
  aadhaarPanUrl       String?
  collegeIdUrl        String?
  passportPhotoUrl    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  attendances         Attendance[]
  feedbacks           Feedback[]
  actionItems         ActionItem[]
  department          Department          @relation("ProfileInterns", fields: [departmentId], references: [id])
  mentor              Mentor?             @relation(fields: [mentorId], references: [id])
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization?       @relation(fields: [organizationId], references: [id])
  leaves              Leave[]
  onboardingProgress  OnboardingProgress?
  tasks               Task[]
  internProjects      InternProject[]
  documents           InternDocument[]
  points              InternPoints?
  badges              InternBadge[]
  xpTransactions      XPTransaction[]
  dailyStandups       DailyStandup[]
  goals               Goal[]
  mockInterviews      MockInterview[]
  cohort              String?
  batchStartDate      DateTime?
  batchEndDate        DateTime?
  batchId             String?
  batch               InternshipBatch?    @relation(fields: [batchId], references: [id])
  skillGapAnalysis    SkillGapAnalysis?
  deletedAt           DateTime?

  @@index([userId])
  @@index([departmentId])
  @@index([mentorId])
  @@index([status])
  @@index([organizationId])
  @@map("interns")
}

model OnboardingProgress {
  id                    String   @id @default(uuid())
  internId              String   @unique
  currentStep           Int      @default(1)
  offerAccepted         Boolean  @default(false)
  personalInfoCompleted Boolean  @default(false)
  educationCompleted    Boolean  @default(false)
  emergencyCompleted    Boolean  @default(false)
  documentsCompleted    Boolean  @default(false)
  agreementAccepted     Boolean  @default(false)
  finalSubmitted        Boolean  @default(false)
  verificationStatus    String   @default("PENDING")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  intern                Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model Mentor {
  id             String            @id @default(uuid())
  userId         String            @unique
  departmentId   String
  organizationId String?
  rating         Float             @default(0)
  expertise      String[]          @default([])
  bio            String?
  phone          String?
  designation    String?
  experience     Int?              @default(0)
  skills         String[]          @default([])
  mentorCapacity Int               @default(5)
  mentorStatus   String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  feedbacks      Feedback[]
  actionItems    ActionItem[]
  interns        Intern[]
  activities     MentorActivity[]
  analytics      MentorAnalytics[]
  documents      MentorDocument[]
  department     Department        @relation("ProfileMentors", fields: [departmentId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  tasks          Task[]
  departmentMentors DepartmentMentor[]
  effectivenessHistories MentorEffectivenessHistory[]

  @@index([userId])
  @@index([departmentId])
  @@index([organizationId])
  @@map("mentors")
}

model MentorAnalytics {
  id                    String   @id @default(uuid())
  mentorId              String
  totalInterns          Int      @default(0)
  completedInternships  Int      @default(0)
  avgRating             Float    @default(0)
  attendanceReviews     Int      @default(0)
  taskReviews           Int      @default(0)
  leaveApprovalsHandled Int      @default(0)
  aiMentorScore         Float?
  performanceTrend      Json?
  effectivenessScore    Float?
  effectivenessGrade    EffectivenessGrade?
  internImprovementRate Float?
  taskSuccessRate       Float?
  atRiskRecoveryRate    Float?
  lastCalculatedAt      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  mentor                Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("mentor_analytics")
}

model MentorDocument {
  id         String   @id @default(uuid())
  mentorId   String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int?
  uploadedAt DateTime @default(now())
  mentor     Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("mentor_documents")
}

model MentorActivity {
  id           String   @id @default(uuid())
  mentorId     String
  activityType String
  description  String
  metadata     Json?
  createdAt    DateTime @default(now())
  mentor       Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([createdAt])
  @@map("mentor_activities")
}

model Task {
  id              String        @id @default(uuid())
  title           String
  description     String
  internId        String
  mentorId        String
  organizationId  String?
  goalId          String?
  isGoalTask      Boolean       @default(false)
  priority        TaskPriority  @default(MEDIUM)
  status          TaskStatus    @default(TODO)
  dueDate         DateTime
  submissionUrl   String?
  submittedAt     DateTime?
  submissionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  intern          Intern        @relation(fields: [internId], references: [id], onDelete: Cascade)
  mentor          Mentor        @relation(fields: [mentorId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  goal            Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?

  @@index([internId])
  @@index([mentorId])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId])
  @@index([goalId])
  @@map("tasks")
}

model Feedback {
  id             String        @id @default(uuid())
  internId       String
  mentorId       String
  organizationId String?
  rating         Int
  comment        String
  category       String?
  sentiment      String?
  sentimentScore Float?
  confidenceScore Float?
  keywords       String[]      @default([])
  executiveInsight String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  intern         Intern        @relation(fields: [internId], references: [id], onDelete: Cascade)
  mentor         Mentor        @relation(fields: [mentorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actionItems    ActionItem[]

  @@index([internId])
  @@index([mentorId])
  @@index([organizationId])
  @@map("feedbacks")
}

model Announcement {
  id             String               @id @default(uuid())
  title          String
  content        String
  priority       AnnouncementPriority @default(MEDIUM)
  audience       String
  author         String
  organizationId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization?        @relation(fields: [organizationId], references: [id])

  @@index([audience])
  @@index([createdAt])
  @@index([organizationId])
  @@map("announcements")
}

model Attendance {
  id             String        @id @default(uuid())
  internId       String
  organizationId String?
  date           DateTime      @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  status         String        @default("ABSENT")
  workingHours   Float?
  lateMinutes    Int?
  markedBy       String?
  deviceInfo     String?
  ipAddress      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  intern         Intern        @relation(fields: [internId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([internId, date])
  @@index([internId])
  @@index([date])
  @@index([organizationId])
  @@map("attendances")
}

model Leave {
  id              String        @id @default(uuid())
  internId        String
  organizationId  String?
  type            LeaveType
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  reason          String
  status          LeaveStatus   @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  intern          Intern        @relation(fields: [internId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([internId])
  @@index([status])
  @@index([startDate])
  @@index([organizationId])
  @@map("leaves")
}

model LeaveRequest {
  id             String        @id @default(uuid())
  userId         String
  mentorId       String?
  hrId           String?
  organizationId String?
  leaveType      String
  reason         String
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  status         String        @default("Pending Mentor")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([organizationId])
  @@map("leave_requests")
}

model Holiday {
  id             String        @id @default(uuid())
  title          String
  date           DateTime      @unique @db.Date
  type           String        @default("NATIONAL")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("holidays")
}

model AttendanceSettings {
  id                  String        @id @default(uuid())
  organizationId      String?
  internshipStartDate DateTime      @db.Date
  internshipEndDate   DateTime      @db.Date
  lateThreshold       String        @default("09:15")
  attendanceCloseTime String        @default("18:00")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organization        Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("attendance_settings")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model TaskFile {
  id                     String      @id @default(uuid())
  taskId                 String
  fileName               String
  fileUrl                String
  fileType               String
  fileSize               Int
  uploadedBy             String
  createdAt              DateTime    @default(now())
  extractedText          String?     @db.Text
  similarityScore        Float?
  mostSimilarTaskId      String?
  aiGeneratedProbability Float?
  trustScore             Int?
  trustLevel             TrustLevel?
  analysisCompletedAt    DateTime?

  @@index([taskId])
  @@map("task_files")
}

model Conversation {
  id             String        @id @default(uuid())
  name           String?
  isGroup        Boolean       @default(false)
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       Message[]
  participants   User[]        @relation("ConversationParticipants")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  videoCalls     VideoCall[]

  @@index([organizationId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  organizationId String?
  content        String
  fileUrl        String?
  fileName       String?
  fileType       String?
  fileSize       Int?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  readBy         User[]        @relation("MessageReadBy")

  @@index([conversationId])
  @@index([senderId])
  @@index([organizationId])
  @@map("messages")
}

model Notification {
  id             String        @id @default(uuid())
  userId         String
  organizationId String?
  title          String
  message        String
  type           String
  isRead         Boolean       @default(false)
  data           Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([organizationId])
  @@map("notifications")
}

model JobPosting {
  id             String        @id @default(uuid())
  title          String
  description    String
  departmentId   String
  organizationId String?
  isActive       Boolean       @default(true)
  requirements   String[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  candidates     Candidate[]
  department     Department    @relation(fields: [departmentId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("job_postings")
}

model Candidate {
  id               String            @id @default(uuid())
  jobPostingId     String
  organizationId   String?
  firstName        String
  lastName         String
  email            String            @unique
  phone            String?
  resumeUrl        String
  parsedSkills     String[]          @default([])
  parsedEducation  Json?
  parsedExperience Json?
  aiMatchScore     Float?
  status           ApplicationStatus @default(APPLIED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  jobPosting       JobPosting        @relation(fields: [jobPostingId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  interviews       Interview[]

  @@index([organizationId])
  @@map("candidates")
}

model Interview {
  id             String        @id @default(uuid())
  candidateId    String
  organizationId String?
  interviewerId  String
  scheduledAt    DateTime
  meetingLink    String?
  feedback       String?
  score          Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  candidate      Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("interviews")
}

model OtpVerification {
  id        String   @id @default(cuid())
  userId    String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_verifications")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  tokenId      String   @unique
  deviceName   String
  browser      String
  ipAddress    String
  isActive     Boolean  @default(true)
  lastActivity DateTime @updatedAt
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  status    String
  browser   String
  device    String
  ipAddress String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_activities")
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  emailNotifications Boolean @default(true)
  attendanceAlerts   Boolean @default(true)
  leaveAlerts        Boolean @default(true)
  taskAlerts         Boolean @default(true)
  announcementAlerts Boolean @default(true)
  weeklyDigest       Boolean @default(true)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model TrustedSession {
  id                String   @id @default(cuid())
  userId            String
  sessionToken      String   @unique
  deviceFingerprint String
  browser           String
  operatingSystem   String
  ipAddress         String?
  status            String
  expiresAt         DateTime
  lastActivityAt    DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("trusted_sessions")
}

model Project {
  id             String          @id @default(uuid())
  title          String
  description    String?
  status         String          @default("ACTIVE")
  departmentId   String
  organizationId String?
  startDate      DateTime?       @db.Date
  endDate        DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  interns        InternProject[]

  @@index([organizationId])
  @@map("projects")
}

model DepartmentActivity {
  id           String     @id @default(uuid())
  departmentId String
  activityType String
  description  String
  performedBy  String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([createdAt])
  @@map("department_activities")
}

enum UserRole {
  SUPER_ADMIN
  HR
  DEPARTMENT_HEAD
  MENTOR
  INTERN
}

enum InternStatus {
  ACTIVE
  COMPLETED
  ONBOARDING
  TERMINATED
  OFFERED
  PENDING
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum AnnouncementPriority {
  HIGH
  MEDIUM
  LOW
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  CASUAL
  EMERGENCY
  OTHER
}

enum ApplicationStatus {
