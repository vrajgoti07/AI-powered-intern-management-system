}

model XPTransaction {
  id             String        @id @default(uuid())
  internId       String
  organizationId String?
  points         Int
  reason         String
  sourceType     String        // "TASK" | "ATTENDANCE" | "FEEDBACK" | "STANDUP" | "ONBOARDING" | "BONUS" | "PENALTY"
  sourceId       String?
  createdAt      DateTime      @default(now())
  intern         Intern        @relation(fields: [internId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([internId])
  @@index([organizationId])
  @@map("xp_transactions")
}

model Badge {
  id          String        @id @default(uuid())
  name        String        @unique
  description String
  iconEmoji   String
  category    String        // "TASKS" | "ATTENDANCE" | "COMMUNITY" | "MILESTONES"
  requirement Json          // Requirements config e.g. { "type": "task_count", "threshold": 10 }
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
