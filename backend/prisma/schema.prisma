generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                  @id @default(uuid())
  email                    String                  @unique
  password                 String
  name                     String
  role                     UserRole
  avatarUrl                String?
  isActive                 Boolean                 @default(true)
  isEmailVerified          Boolean                 @default(false)
  resetPasswordToken       String?                 @unique
  resetPasswordTokenExpiry DateTime?
  refreshToken             String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  lastLogin                DateTime?
  departmentId             String?
  mentorDepartmentId       String?
  headedDepartment         Department?             @relation("DepartmentHead")
  intern                   Intern?
  leaveRequests            LeaveRequest[]          @relation("UserLeaveRequests")
  loginActivities          LoginActivity[]
  mentor                   Mentor?
  sentMessages             Message[]               @relation("MessageSender")
  notificationPreference   NotificationPreference?
  notifications            Notification[]
  otpVerifications         OtpVerification[]
  trustedSessions          TrustedSession[]
  userSessions             UserSession[]
  department               Department?             @relation("DepartmentInterns", fields: [departmentId], references: [id])
  mentorDepartment         Department?             @relation("DepartmentMentors", fields: [mentorDepartmentId], references: [id])
  conversations            Conversation[]          @relation("ConversationParticipants")
  readMessages             Message[]               @relation("MessageReadBy")
  chatRooms                ChatRoom[]              @relation("ChatRoomMembers")
  parsedResumes            ParsedResume[]
  deletedAt                DateTime?

  @@index([email])
  @@index([role])
  @@map("users")
}

model Department {
  id             String               @id @default(uuid())
  name           String               @unique
  code           String               @unique
  description    String?
  colorTheme     String?              @map("color")
  isActive       Boolean              @default(true)
  headId         String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  activities     DepartmentActivity[]
  head           User?                @relation("DepartmentHead", fields: [headId], references: [id])
  profileInterns Intern[]             @relation("ProfileInterns")
  jobPostings    JobPosting[]
  profileMentors Mentor[]             @relation("ProfileMentors")
  projects       Project[]
  interns        User[]               @relation("DepartmentInterns")
  mentors        User[]               @relation("DepartmentMentors")
  departmentMentors DepartmentMentor[]
  deletedAt      DateTime?

  @@map("departments")
}

model Intern {
  id                  String              @id @default(uuid())
  userId              String              @unique
  phone               String?
  dob                 DateTime?
  college             String
  degree              String?
  branch              String?
  cgpa                Float?
  departmentId        String
  mentorId            String?
  status              InternStatus        @default(PENDING)
  score               Float               @default(0)
  attendance          Float               @default(0)
  skills              String[]            @default([])
  experience          Json?
  education           Json?
  duration            String?
  startDate           DateTime?
  joinedDate          DateTime            @default(now())
  completedDate       DateTime?
  whyJoin             String?
  resumeUrl           String?
  address             String?
  workAddress         String?
  emergencyName       String?
  emergencyRelation   String?
  emergencyPhone      String?
  signedName          String?
  agreementAccepted   Boolean             @default(false)
  offerLetterAccepted Boolean             @default(false)
  onboardingStep      Int                 @default(0)
  gender              String?
  semester            Int?
  parentName          String?
  parentPhone         String?
  idProofUrl          String?
  marksheetUrl        String?
  aadhaarPanUrl       String?
  collegeIdUrl        String?
  passportPhotoUrl    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  attendances         Attendance[]
  feedbacks           Feedback[]
  department          Department          @relation("ProfileInterns", fields: [departmentId], references: [id])
  mentor              Mentor?             @relation(fields: [mentorId], references: [id])
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves              Leave[]
  onboardingProgress  OnboardingProgress?
  tasks               Task[]
  internProjects      InternProject[]
  documents           InternDocument[]
  deletedAt           DateTime?

  @@index([userId])
  @@index([departmentId])
  @@index([mentorId])
  @@index([status])
  @@map("interns")
}

model OnboardingProgress {
  id                    String   @id @default(uuid())
  internId              String   @unique
  currentStep           Int      @default(1)
  offerAccepted         Boolean  @default(false)
  personalInfoCompleted Boolean  @default(false)
  educationCompleted    Boolean  @default(false)
  emergencyCompleted    Boolean  @default(false)
  documentsCompleted    Boolean  @default(false)
  agreementAccepted     Boolean  @default(false)
  finalSubmitted        Boolean  @default(false)
  verificationStatus    String   @default("PENDING")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  intern                Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model Mentor {
  id             String            @id @default(uuid())
  userId         String            @unique
  departmentId   String
  rating         Float             @default(0)
  expertise      String[]          @default([])
  bio            String?
  phone          String?
  designation    String?
  experience     Int?              @default(0)
  skills         String[]          @default([])
  mentorCapacity Int               @default(5)
  mentorStatus   String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  feedbacks      Feedback[]
  interns        Intern[]
  activities     MentorActivity[]
  analytics      MentorAnalytics[]
  documents      MentorDocument[]
  department     Department        @relation("ProfileMentors", fields: [departmentId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  departmentMentors DepartmentMentor[]

  @@index([userId])
  @@index([departmentId])
  @@map("mentors")
}

model MentorAnalytics {
  id                    String   @id @default(uuid())
  mentorId              String
  totalInterns          Int      @default(0)
  completedInternships  Int      @default(0)
  avgRating             Float    @default(0)
  attendanceReviews     Int      @default(0)
  taskReviews           Int      @default(0)
  leaveApprovalsHandled Int      @default(0)
  aiMentorScore         Float?
  performanceTrend      Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  mentor                Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("mentor_analytics")
}

model MentorDocument {
  id         String   @id @default(uuid())
  mentorId   String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int?
  uploadedAt DateTime @default(now())
  mentor     Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("mentor_documents")
}

model MentorActivity {
  id           String   @id @default(uuid())
  mentorId     String
  activityType String
  description  String
  metadata     Json?
  createdAt    DateTime @default(now())
  mentor       Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([createdAt])
  @@map("mentor_activities")
}

model Task {
  id              String       @id @default(uuid())
  title           String
  description     String
  internId        String
  mentorId        String
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(TODO)
  dueDate         DateTime
  submissionUrl   String?
  submittedAt     DateTime?
  submissionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  intern          Intern       @relation(fields: [internId], references: [id], onDelete: Cascade)
  mentor          Mentor       @relation(fields: [mentorId], references: [id])
  deletedAt       DateTime?

  @@index([internId])
  @@index([mentorId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model Feedback {
  id        String   @id @default(uuid())
  internId  String
  mentorId  String
  rating    Int
  comment   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  intern    Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  mentor    Mentor   @relation(fields: [mentorId], references: [id])

  @@index([internId])
  @@index([mentorId])
  @@map("feedbacks")
}

model Announcement {
  id        String               @id @default(uuid())
  title     String
  content   String
  priority  AnnouncementPriority @default(MEDIUM)
  audience  String
  author    String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([audience])
  @@index([createdAt])
  @@map("announcements")
}

model Attendance {
  id           String    @id @default(uuid())
  internId     String
  date         DateTime  @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       String    @default("ABSENT")
  workingHours Float?
  lateMinutes  Int?
  markedBy     String?
  deviceInfo   String?
  ipAddress    String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  intern       Intern    @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@index([internId])
  @@index([date])
  @@map("attendances")
}

model Leave {
  id              String      @id @default(uuid())
  internId        String
  type            LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  intern          Intern      @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([status])
  @@index([startDate])
  @@map("leaves")
}

model LeaveRequest {
  id        String   @id @default(uuid())
  userId    String
  mentorId  String?
  hrId      String?
  leaveType String
  reason    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    String   @default("Pending Mentor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model Holiday {
  id    String   @id @default(uuid())
  title String
  date  DateTime @unique @db.Date
  type  String   @default("NATIONAL")

  @@map("holidays")
}

model AttendanceSettings {
  id                  String   @id @default(uuid())
  internshipStartDate DateTime @db.Date
  internshipEndDate   DateTime @db.Date
  lateThreshold       String   @default("09:15")
  attendanceCloseTime String   @default("18:00")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("attendance_settings")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model TaskFile {
  id         String   @id @default(uuid())
  taskId     String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([taskId])
  @@map("task_files")
}

model Conversation {
  id           String    @id @default(uuid())
  name         String?
  isGroup      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
  participants User[]    @relation("ConversationParticipants")

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  fileUrl        String?
  fileName       String?
  fileType       String?
  fileSize       Int?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  readBy         User[]       @relation("MessageReadBy")

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model JobPosting {
  id           String      @id @default(uuid())
  title        String
  description  String
  departmentId String
  isActive     Boolean     @default(true)
  requirements String[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  candidates   Candidate[]
  department   Department  @relation(fields: [departmentId], references: [id])

  @@map("job_postings")
}

model Candidate {
  id               String            @id @default(uuid())
  jobPostingId     String
  firstName        String
  lastName         String
  email            String            @unique
  phone            String?
  resumeUrl        String
  parsedSkills     String[]          @default([])
  parsedEducation  Json?
  parsedExperience Json?
  aiMatchScore     Float?
  status           ApplicationStatus @default(APPLIED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  jobPosting       JobPosting        @relation(fields: [jobPostingId], references: [id])
  interviews       Interview[]

  @@map("candidates")
}

model Interview {
  id            String    @id @default(uuid())
  candidateId   String
  interviewerId String
  scheduledAt   DateTime
  meetingLink   String?
  feedback      String?
  score         Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

model OtpVerification {
  id        String   @id @default(cuid())
  userId    String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_verifications")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  tokenId      String   @unique
  deviceName   String
  browser      String
  ipAddress    String
  isActive     Boolean  @default(true)
  lastActivity DateTime @updatedAt
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  status    String
  browser   String
  device    String
  ipAddress String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_activities")
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  emailNotifications Boolean @default(true)
  attendanceAlerts   Boolean @default(true)
  leaveAlerts        Boolean @default(true)
  taskAlerts         Boolean @default(true)
  announcementAlerts Boolean @default(true)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model TrustedSession {
  id                String   @id @default(cuid())
  userId            String
  sessionToken      String   @unique
  deviceFingerprint String
  browser           String
  operatingSystem   String
  ipAddress         String?
  status            String
  expiresAt         DateTime
  lastActivityAt    DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("trusted_sessions")
}

model Project {
  id           String          @id @default(uuid())
  title        String
  description  String?
  status       String          @default("ACTIVE")
  departmentId String
  startDate    DateTime?       @db.Date
  endDate      DateTime?       @db.Date
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  interns      InternProject[]

  @@map("projects")
}

model DepartmentActivity {
  id           String     @id @default(uuid())
  departmentId String
  activityType String
  description  String
  performedBy  String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([createdAt])
  @@map("department_activities")
}

enum UserRole {
  SUPER_ADMIN
  HR
  DEPARTMENT_HEAD
  MENTOR
  INTERN
}

enum InternStatus {
  ACTIVE
  COMPLETED
  ONBOARDING
  TERMINATED
  OFFERED
  PENDING
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum AnnouncementPriority {
  HIGH
  MEDIUM
  LOW
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  CASUAL
  EMERGENCY
  OTHER
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  REJECTED
}

model ChatRoom {
  id        String   @id @default(uuid())
  name      String?
  createdAt DateTime @default(now())
  members   User[]   @relation("ChatRoomMembers")

  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  @@map("chat_messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model AIRecommendation {
  id         String   @id @default(uuid())
  internId   String
  mentorId   String
  matchScore Float
  confidence String
  reasons    Json
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ai_recommendations")
}

model DepartmentMentor {
  id           String     @id @default(uuid())
  departmentId String
  mentorId     String
  assignedAt   DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  mentor       Mentor     @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([departmentId, mentorId])
  @@index([departmentId])
  @@index([mentorId])
  @@map("department_mentors")
}

model InternProject {
  id         String   @id @default(uuid())
  internId   String
  projectId  String
  role       String   @default("MEMBER")
  assignedAt DateTime @default(now())
  intern     Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([internId, projectId])
  @@index([internId])
  @@index([projectId])
  @@map("intern_projects")
}

model EmailLog {
  id           String   @id @default(uuid())
  to           String
  subject      String
  status       String   @default("PENDING") // PENDING, SENT, FAILED
  error        String?
  attempts     Int      @default(0)
  templateName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([to])
  @@map("email_logs")
}

model InternDocument {
  id         String   @id @default(uuid())
  internId   String
  type       String   // 'CERTIFICATE', 'OFFER_LETTER', 'PERFORMANCE_REPORT'
  name       String   // e.g., "Certificate of Completion", "Monthly Report - May 2026"
  url        String   // Cloudinary URL
  publicId   String   // Cloudinary public ID
  metadata   Json?    // Optional metadata (e.g., month/year for reports)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  intern     Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([type])
  @@map("intern_documents")
}

model ParsedResume {
  id              String   @id @default(uuid())
  userId          String
  name            String
  email           String
  phone           String
  skills          String[] @default([])
  education       Json?
  experience      Json?
  projects        Json?
  skillScore      Float
  experienceYears Float
  deletedByUser   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("parsed_resumes")
}
