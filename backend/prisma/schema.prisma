// ── Custom Report Builder (Feature #10) ───────────────────────────

model SavedReport {
  id               String        @id @default(uuid())
  organizationId   String?
  createdBy        String
  name             String
  description      String?       @db.Text
  selectedColumns  Json          // string array of selected columns
  filters          Json          // filter criteria
  sortBy           String?
  sortOrder        String        @default("DESC") // "ASC" | "DESC"
  lastGeneratedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization? @relation(fields: [organizationId], references: [id])

  @@map("saved_reports")
}

// ── Mentor Effectiveness Score (Feature #11) ──────────────────────

enum EffectivenessGrade {
  EXCELLENT
  GOOD
  AVERAGE
  NEEDS_IMPROVEMENT
}

model MentorEffectivenessHistory {
  id             String        @id @default(uuid())
  mentorId       String
  organizationId String?
  score          Float
  grade          EffectivenessGrade
  calculatedAt   DateTime      @default(now())
  snapshot       Json          // full snapshot details

  organization   Organization? @relation(fields: [organizationId], references: [id])
  mentor         Mentor        @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentor_effectiveness_histories")
}

// ── GDPR Data Export & Erasure (Feature #17) ─────────────────────

enum ExportRequestStatus {
  PENDING
  PROCESSING
  READY
  DOWNLOADED
  EXPIRED
}

enum GDPRRequestType {
  EXPORT
  ERASURE
}

enum ErasureRequestStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  REJECTED
}

model DataExportRequest {
  id             String              @id @default(uuid())
  userId         String
  organizationId String?
  status         ExportRequestStatus @default(PENDING)
  requestType    GDPRRequestType     @default(EXPORT)
  fileUrl        String?
  expiresAt      DateTime?
  processedAt    DateTime?
  downloadedAt   DateTime?
  createdAt      DateTime            @default(now())

  organization   Organization?       @relation(fields: [organizationId], references: [id])

  @@map("data_export_requests")
}

model ErasureRequest {
  id             String               @id @default(uuid())
  userId         String
  organizationId String?
  status         ErasureRequestStatus @default(PENDING)
  reason         String?              @db.Text
  confirmedAt    DateTime?
  processedAt    DateTime?
  processedBy    String?
  createdAt      DateTime             @default(now())

  organization   Organization?        @relation(fields: [organizationId], references: [id])

  @@map("erasure_requests")
}

