{
  "name": "ai-intern-management-backend",
  "version": "1.0.0",
  "description": "Backend for AI-Powered Intern Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "node ./node_modules/prisma/build/index.js generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma generate && prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "cross-env NODE_ENV=development ts-node prisma/seed.ts",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "test": "jest --passWithNoTests",
    "deploy": "prisma generate && prisma migrate deploy && node dist/server.js",
    "prebackup": "ts-node scripts/neon-backup.ts"
  },
  "keywords": [
    "intern",
    "management",
    "ai",
    "backend"
  ],
  "author": "",
  "license": "MIT",
