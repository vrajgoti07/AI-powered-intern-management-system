# Dependency directories
**/node_modules/
**/jspm_packages/
**/web_modules/

# Build outputs and distribution directories
**/dist/
**/build/
**/out/
**/.next/
**/.nuxt/
**/.cache/
**/.parcel-cache/
**/.eslintcache/

# Environments and Secrets
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.env
**/*.env.*
**/active-env.json

# Databases and local sqlite databases
**/*.db
**/*.sqlite
**/*.sqlite-journal

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# System Files
**/.DS_Store
**/Thumbs.db
**/ehthumbs.db
**/desktop.ini

# IDEs and Editors
**/.idea/
**/.vscode/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# Python virtual envs and caches
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.venv/
**/venv/
**/ENV/
**/env/
**/.pytest_cache/
**/.mypy_cache/
**/.ipynb_checkpoints/
**/*.egg-info/
**/.eggs/
**/develop-eggs/
**/downloads/
**/eggs/
**/lib/
**/lib64/
**/parts/
**/sdist/
**/var/
**/wheels/
**/share/python-wheels/

# Local testing and coverage reports
**/coverage/
**/.nyc_output/
**/.htmlcov/
**/htmlcov/

# Temporary and backup files
**/*~
**/*.bak
**/*.tmp
**/*.temp
